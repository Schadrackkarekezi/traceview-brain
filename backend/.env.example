OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Local dev Postgres — matches docker-compose.yml's db service.
# traceview_readonly is the actual safety boundary for query execution
# (SELECT-only, enforced by Postgres — see schema.sql), not a real secret.
DATABASE_URL=postgresql://traceview:traceview_dev_only@localhost:5432/traceview
DATABASE_URL_READONLY=postgresql://traceview_readonly:traceview_readonly_dev_only@localhost:5432/traceview

# HydraDB - the company-brain layer (shared knowledge, per-user memory,
# context graph). Optional: leave HYDRA_DB_API_KEY blank and retrieval
# stays on pgvector with no memory. Get a key at https://app.hydradb.com,
# then run `python -m scripts.seed_hydra` once to load the knowledge.
HYDRA_DB_API_KEY=
HYDRA_DB_DATABASE=traceview_brain
HYDRA_DB_COLLECTION=gtm_knowledge
# fast | thinking | auto. Company-wide playbook search defaults to fast;
# account-scoped search defaults to thinking, the only mode that returns
# graph paths (about a second slower).
HYDRA_DB_QUERY_MODE=fast
HYDRA_DB_ACCOUNT_QUERY_MODE=thinking
# Set to pgvector to force the old retrieval path even with a key present.
RETRIEVAL_BACKEND=
